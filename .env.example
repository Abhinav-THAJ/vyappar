# --- Database -------------------------------------------------------------
# Matches docker-compose.yml. Run: pnpm db:up
DATABASE_URL="postgresql://bella:bella@localhost:5434/bella_books?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Derive the origin from the incoming request, so the app works on any port
# and behind a proxy. Do not pin NEXTAUTH_URL here.
AUTH_TRUST_HOST="true"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Bella Books"
# Only used to build shareable links (WhatsApp, invoice links). Set this to
# your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local disk path for attachments and logos (relative to project root).
UPLOAD_DIR="public/uploads"
